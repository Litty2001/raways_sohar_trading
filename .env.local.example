# WhatsApp Cloud API configuration (server-only — never prefix these with NEXT_PUBLIC_).
# This example file is safe to commit. Copy it to .env.local and fill in real values;
# .env.local itself must NEVER be committed (it is ignored via .env*.local in .gitignore).

# Permanent System User access token from Meta Business Settings. Secret.
WHATSAPP_ACCESS_TOKEN=

# WhatsApp Business phone number ID (not secret).
WHATSAPP_PHONE_NUMBER_ID=1353724421159145

# Business WhatsApp number that receives quote requests, with country code, digits only (e.g. 9689XXXXXXX).
WHATSAPP_RECIPIENT_NUMBER=

# Approved Utility template and its language code (must be "en", not "en_US").
WHATSAPP_TEMPLATE_NAME=website_quote_request
WHATSAPP_TEMPLATE_LANGUAGE=en
